{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "SMASH BURGER BAR — cartoon-retro sticker system. Warm cream base, bright red accent, hand-drawn flat-vector ingredient palette with thick dark outline. GOLD reserved for the Signature tier. Three layers: Primitive → Semantic → Component.",
  "primitive": {
    "color": {
      "cream": {
        "50":  { "$value": "#FBF1E1", "$type": "color" },
        "100": { "$value": "#F5E3CD", "$type": "color" },
        "200": { "$value": "#EED8BC", "$type": "color" },
        "300": { "$value": "#E4C9A6", "$type": "color" }
      },
      "ketchup": {
        "400": { "$value": "#FF3A32", "$type": "color" },
        "500": { "$value": "#F91814", "$type": "color" },
        "600": { "$value": "#D8120F", "$type": "color" },
        "700": { "$value": "#A50F0C", "$type": "color" }
      },
      "ink": {
        "900": { "$value": "#3A1620", "$type": "color" },
        "700": { "$value": "#5A2530", "$type": "color" }
      },
      "gold": {
        "300": { "$value": "#FBE29A", "$type": "color" },
        "400": { "$value": "#E5C77C", "$type": "color" },
        "500": { "$value": "#D4AF5A", "$type": "color" },
        "700": { "$value": "#8A6E2E", "$type": "color" }
      },
      "sticker": {
        "orange": { "$value": "#FBAF2B", "$type": "color" },
        "yellow": { "$value": "#F5C043", "$type": "color" }
      },
      "cartoon": {
        "outline":       { "$value": "#4A1520", "$type": "color" },
        "bun":           { "$value": "#F0913F", "$type": "color" },
        "bun-shadow":    { "$value": "#D9772E", "$type": "color" },
        "bun-hi":        { "$value": "#FBBE7A", "$type": "color" },
        "lettuce":       { "$value": "#7CBB45", "$type": "color" },
        "lettuce-shadow":{ "$value": "#5E9A33", "$type": "color" },
        "tomato":        { "$value": "#E4443A", "$type": "color" },
        "tomato-shadow": { "$value": "#C6362E", "$type": "color" },
        "cheese":        { "$value": "#F5C043", "$type": "color" },
        "cheese-shadow": { "$value": "#E0A82E", "$type": "color" },
        "patty":         { "$value": "#9C5A33", "$type": "color" },
        "patty-shadow":  { "$value": "#7E4526", "$type": "color" }
      },
      "curtain": {
        "red":    { "$value": "#F91814", "$type": "color" },
        "orange": { "$value": "#F0913F", "$type": "color" },
        "bordo":  { "$value": "#7A1512", "$type": "color" },
        "cream":  { "$value": "#F5E3CD", "$type": "color" }
      }
    },
    "font": {
      "logo":    { "$value": "var(--font-anton), 'Anton', 'Arial Narrow', sans-serif", "$type": "fontFamily" },
      "display": { "$value": "var(--font-modak), 'Modak', system-ui, sans-serif", "$type": "fontFamily" },
      "body":    { "$value": "var(--font-mouse), 'Mouse Memoirs', system-ui, sans-serif", "$type": "fontFamily" }
    },
    "motion": {
      "duration": {
        "micro":  { "$value": "180ms", "$type": "duration" },
        "base":   { "$value": "300ms", "$type": "duration" },
        "reveal": { "$value": "900ms", "$type": "duration" },
        "cine":   { "$value": "1.6s",  "$type": "duration" }
      },
      "ease": {
        "out-expo": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)",  "$type": "cubicBezier" },
        "pop":      { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$type": "cubicBezier" },
        "snap":     { "$value": "cubic-bezier(0.22, 1, 0.36, 1)", "$type": "cubicBezier" }
      }
    },
    "tracking": {
      "display": { "$value": "0.01em", "$type": "dimension" },
      "label":   { "$value": "0.18em", "$type": "dimension" }
    },
    "space": {
      "3xs": { "$value": "0.25rem", "$type": "dimension" },
      "2xs": { "$value": "0.5rem",  "$type": "dimension" },
      "xs":  { "$value": "0.75rem", "$type": "dimension" },
      "sm":  { "$value": "1rem",    "$type": "dimension" },
      "md":  { "$value": "1.5rem",  "$type": "dimension" },
      "lg":  { "$value": "2rem",    "$type": "dimension" },
      "xl":  { "$value": "3rem",    "$type": "dimension" },
      "2xl": { "$value": "4rem",    "$type": "dimension" },
      "3xl": { "$value": "6rem",    "$type": "dimension" },
      "4xl": { "$value": "8rem",    "$type": "dimension" },
      "5xl": { "$value": "10rem",   "$type": "dimension" }
    },
    "size": {
      "container-narrow":  { "$value": "42rem", "$type": "dimension" },
      "container-content": { "$value": "68rem", "$type": "dimension" },
      "container-wide":    { "$value": "84rem", "$type": "dimension" },
      "container-full":    { "$value": "96rem", "$type": "dimension" },
      "gutter":            { "$value": "clamp(1.25rem, 5vw, 5rem)", "$type": "dimension" }
    },
    "radius": {
      "sm":   { "$value": "0.75rem", "$type": "dimension" },
      "md":   { "$value": "1.25rem", "$type": "dimension" },
      "lg":   { "$value": "2rem",    "$type": "dimension" },
      "pill": { "$value": "999px",   "$type": "dimension" }
    }
  },

  "semantic": {
    "background":          { "$value": "{primitive.color.cream.100}", "$type": "color" },
    "background-alt":      { "$value": "{primitive.color.cream.50}",  "$type": "color" },
    "surface":            { "$value": "{primitive.color.cream.50}",  "$type": "color" },
    "surface-red":         { "$value": "{primitive.color.ketchup.500}", "$type": "color" },
    "foreground":          { "$value": "{primitive.color.ink.900}",  "$type": "color" },
    "muted-foreground":    { "$value": "{primitive.color.ink.700}",  "$type": "color" },
    "on-red":              { "$value": "{primitive.color.cream.100}", "$type": "color" },
    "border":              { "$value": "{primitive.color.cartoon.outline}", "$type": "color" },

    "primary":             { "$value": "{primitive.color.ketchup.500}", "$type": "color" },
    "primary-strong":      { "$value": "{primitive.color.ketchup.600}", "$type": "color" },
    "primary-foreground":  { "$value": "{primitive.color.cream.100}",   "$type": "color" },
    "ring":                { "$value": "{primitive.color.ketchup.500}", "$type": "color" },

    "sticker-bg":          { "$value": "{primitive.color.sticker.orange}", "$type": "color" },
    "sticker-fg":          { "$value": "{primitive.color.ink.900}",        "$type": "color" },
    "outline-ink":         { "$value": "{primitive.color.cartoon.outline}", "$type": "color" },
    "stroke-cream":        { "$value": "{primitive.color.cream.50}",       "$type": "color" },

    "signature":            { "$value": "{primitive.color.gold.500}", "$type": "color" },
    "signature-bright":     { "$value": "{primitive.color.gold.400}", "$type": "color" },
    "signature-deep":       { "$value": "{primitive.color.gold.700}", "$type": "color" },
    "signature-foreground": { "$value": "{primitive.color.ink.900}",  "$type": "color" },

    "radius":       { "$value": "{primitive.radius.md}",   "$type": "dimension" },
    "radius-pill":  { "$value": "{primitive.radius.pill}", "$type": "dimension" },

    "type-logo":    { "$value": "{primitive.font.logo}",    "$type": "fontFamily" },
    "type-display": { "$value": "{primitive.font.display}", "$type": "fontFamily" },
    "type-body":    { "$value": "{primitive.font.body}",    "$type": "fontFamily" },

    "ease-reveal":     { "$value": "{primitive.motion.ease.out-expo}", "$type": "cubicBezier" },
    "ease-pop":        { "$value": "{primitive.motion.ease.pop}",      "$type": "cubicBezier" },
    "ease-snap":       { "$value": "{primitive.motion.ease.snap}",     "$type": "cubicBezier" },
    "duration-micro":  { "$value": "{primitive.motion.duration.micro}",  "$type": "duration" },
    "duration-base":   { "$value": "{primitive.motion.duration.base}",   "$type": "duration" },
    "duration-reveal": { "$value": "{primitive.motion.duration.reveal}", "$type": "duration" },

    "tracking-display": { "$value": "{primitive.tracking.display}", "$type": "dimension" },
    "tracking-label":   { "$value": "{primitive.tracking.label}",   "$type": "dimension" }
  },

  "component": {
    "type": {
      "hero-size":     { "$value": "clamp(3.5rem, 20vw, 18rem)", "$type": "dimension" },
      "hero-leading":  { "$value": "0.9", "$type": "number" },
      "display1-size": { "$value": "clamp(3rem, 10vw, 9rem)",    "$type": "dimension" },
      "display2-size": { "$value": "clamp(2.25rem, 6vw, 5rem)",  "$type": "dimension" },
      "section-size":  { "$value": "clamp(1.75rem, 4vw, 3.5rem)","$type": "dimension" },
      "body-lg":       { "$value": "1.35rem",  "$type": "dimension" },
      "body-size":     { "$value": "1.15rem",  "$type": "dimension" },
      "body-leading":  { "$value": "1.35", "$type": "number" },
      "label-size":    { "$value": "0.95rem", "$type": "dimension" }
    },
    "sticker": {
      "text-stroke":   { "$value": "clamp(3px, 0.9vw, 10px)", "$type": "dimension" },
      "letter-rotate": { "$value": "3deg", "$type": "dimension" }
    },
    "button": {
      "primary-bg":       { "$value": "{primitive.color.ketchup.500}", "$type": "color" },
      "primary-fg":       { "$value": "{primitive.color.cream.100}",   "$type": "color" },
      "primary-hover-bg": { "$value": "{primitive.color.ink.900}",     "$type": "color" },
      "ghost-border":     { "$value": "{primitive.color.cartoon.outline}", "$type": "color" },
      "ghost-fg":         { "$value": "{primitive.color.ink.900}",     "$type": "color" }
    }
  }
}
